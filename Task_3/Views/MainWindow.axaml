<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Task_3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Task_3.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Task_3">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Очистить"
                          Command="{Binding ClearCommand}" />

                <MenuItem Header="Выход"
                          Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="Справка">
                <MenuItem Header="О программе"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <ScrollViewer>
            <StackPanel Margin="20"
                        Spacing="12">

                <Image Source="/Assets/avalonia-logo.ico"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />

                <TextBlock Text="Hello Avalonia App"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,10" />

                <Grid ColumnDefinitions="170,*"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10"
                      ColumnSpacing="10">

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Имя:"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Введите имя" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Профессия:"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding Profession, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Введите профессию" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Любимый UI-фреймворк:"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding FavoriteFramework, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Avalonia" />

                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">

                    <Button Content="Создать приветствие"
                            Command="{Binding CreateGreetingCommand}" />

                    <Button Content="Очистить"
                            Command="{Binding ClearCommand}" />

                </StackPanel>

                <TextBlock Text="Результат:"
                           FontWeight="Bold"
                           Margin="0,20,0,0" />

                <Border BorderThickness="1"
                        Padding="10"
                        CornerRadius="6">

                    <TextBlock Text="{Binding ResultText}"
                               TextWrapping="Wrap"
                               FontSize="16" />

                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
    
</Window>
